# The design review service the /review page talks to (see the design-review repo).
PUBLIC_REVIEW_SERVICE_URL=http://localhost:9300
PUBLIC_REVIEW_PROJECT=mvp

# The Figma sync tool reads its settings from the shell, or from this same kind of file: put them in .env.local (git-ignored), never here.
# Note: the tool's address ends in /api/v1; the page's address above is the origin only.
# REVIEW_API_URL=http://localhost:9300/api/v1
# REVIEW_PROJECT=mvp
# REVIEW_API_KEY=drp_...   (a project token made in the service)
